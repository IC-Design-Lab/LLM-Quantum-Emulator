@article{10.1145/3762672,
author = {Cicero, Alessio and Maleki, Mohammad Ali and Azhar, Muhammad Waqar and Kockum, Anton Frisk and Trancoso, Pedro},
title = {Simulation of Quantum Computers: Review and Acceleration Opportunities},
year = {2025},
issue_date = {March 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {7},
number = {1},
url = {https://doi.org/10.1145/3762672},
doi = {10.1145/3762672},
abstract = {Quantum computing has the potential to revolutionise multiple fields by solving complex problems that cannot be solved in reasonable time with current classical computers. Nevertheless, the development of quantum computers is still in its early stages and the available systems have still very limited resources. As such, currently, the most practical way to develop and test quantum algorithms is to use classical simulators of quantum computers. In addition, the development of new quantum computers and their components also depends on simulations.Given the characteristics of a quantum computer, their simulation is a very demanding application in terms of both computation and memory. As such, simulations do not scale well in current classical systems. Thus different optimisation and approximation techniques need to be applied at different levels.This review provides an overview of the components of a quantum computer, the levels at which these components and the whole quantum computer can be simulated, and an in-depth analysis of different state-of-the-art acceleration approaches. Besides the optimisations that can be performed at the algorithmic level, this review presents the most promising hardware-aware optimisations and future directions that can be explored for improving the performance and scalability of the simulations.},
journal = {ACM Transactions on Quantum Computing},
month = nov,
articleno = {3},
numpages = {35},
keywords = {Quantum computing, computer simulation, hardware acceleration, CPU, GPU, FPGA}
}

