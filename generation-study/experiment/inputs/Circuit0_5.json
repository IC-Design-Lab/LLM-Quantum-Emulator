{
  "version": "1.0",
  "circuit_name": "Circuit0_5",
  "description": "Hadamard on all qubits, then X (NOT) on qubit 1 followed by SqrtX-dagger (SX†) on qubit 1 (sharing permutation layers), then SWAP across both qubits",
  "qubits": [
    {
      "id": 0,
      "name": "q0"
    },
    {
      "id": 1,
      "name": "q1"
    }
  ],
  "operations": [
    {
      "step": 0,
      "gate": "H",
      "targets": [
        0,
        1
      ],
      "module": "HGate2QubitVector16bit",
      "instance_name": "m",
      "perm_required": false,
      "pipeline_cycles": 5,
      "reason": "H targets all qubits simultaneously — no permutation needed"
    },
    {
      "step": 1,
      "gate": "X",
      "targets": [
        1
      ],
      "module": "XGate2QubitVector16bit",
      "instance_name": "m_2",
      "perm_required": true,
      "pipeline_cycles": 1,
      "reason": "X targets qubit 1 — inside a shared CompatiblePerm bracket with the following SX-dagger"
    },
    {
      "step": 2,
      "gate": "SXD",
      "targets": [
        1
      ],
      "module": "SXDGate2QubitVector16bit",
      "instance_name": "m_3",
      "perm_required": true,
      "pipeline_cycles": 1,
      "reason": "SqrtX-dagger targets qubit 1 — shares the CompatiblePerm bracket opened before the X"
    },
    {
      "step": 3,
      "gate": "SWAP",
      "targets": [
        0,
        1
      ],
      "module": "SWGate2QubitVector16bit",
      "instance_name": "m_5",
      "perm_required": false,
      "pipeline_cycles": 1,
      "reason": "SWAP operates across full vector — no permutation needed"
    }
  ],
  "hardware_pipeline": [
    {
      "stage": 0,
      "module": "HGate2QubitVector16bit",
      "instance": "m",
      "cycles": 5
    },
    {
      "stage": 1,
      "module": "CompatiblePerm",
      "instance": "m_1",
      "cycles": 1
    },
    {
      "stage": 2,
      "module": "XGate2QubitVector16bit",
      "instance": "m_2",
      "cycles": 1
    },
    {
      "stage": 3,
      "module": "SXDGate2QubitVector16bit",
      "instance": "m_3",
      "cycles": 1
    },
    {
      "stage": 4,
      "module": "CompatiblePerm",
      "instance": "m_4",
      "cycles": 1
    },
    {
      "stage": 5,
      "module": "SWGate2QubitVector16bit",
      "instance": "m_5",
      "cycles": 1
    }
  ],
  "total_pipeline_cycles": 11,
  "architecture_rules": {
    "perm_rule": "Insert CompatiblePerm before AND after any gate whose target qubit is not qubit 0",
    "perm_module": "CompatiblePerm",
    "perm_cycles": 1,
    "wrapper_rule": "Always use 2QubitVector16bit wrapper modules — never use primitive gates directly",
    "wire_naming": "Intermediate wires named _m_N_io_out_QSV_X_Y where N is stage index starting at 0",
    "valid_chain": "Each stage io_in_valid connects to previous stage io_out_valid",
    "final_output": "Last stage outputs connect directly to top-level io_out ports",
    "valid_output": "io_out_valid connects directly from last stage io_out_valid"
  },
  "gate_library": {
