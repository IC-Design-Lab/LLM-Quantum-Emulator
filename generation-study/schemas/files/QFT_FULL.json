  ],
  "total_pipeline_cycles": 25,
  "pipeline_cycles_note": "Sum of nominal per-stage cycles; confirm against measured io_out_valid latency.",
  "architecture_rules": {
    "perm_rule": "Insert CompatiblePerm before AND after any gate whose target qubit is not in the default position (q0 for single-qubit; (q1,q0) for two-qubit gates)",
    "perm_modules": [
      "CompatiblePerm",
      "CompatiblePerm_1",
      "CompatiblePerm_2"
    ],
    "perm_note": "Different CompatiblePerm variants reorder different qubit positions (e.g. swap positions 3&2, 3&1, 2&1 at size 8). Use the specific variant that maps the target qubit to the default position.",
    "wrapper_rule": "Use the 3QubitVector8bit wrapper modules - never primitive gates",
    "valid_chain": "Each stage io_in_valid connects to previous stage io_out_valid",
    "final_output": "Last stage outputs connect to top-level io_out ports"
  },
  "gate_library": {
    "available_modules": [
      {
        "gate": "H",
        "module": "HGate3QubitVector8bit",
        "pipeline_cycles": 5,
        "desc": "Hadamard across the 8-amplitude state vector"
      },
      {
        "gate": "CS",
        "module": "CSGate3QubitVector8bit",
        "pipeline_cycles": 1,
        "desc": "Controlled-S phase gate"
      },
      {
        "gate": "CT",
        "module": "CTGate3QubitVector8bit",
        "pipeline_cycles": 1,
        "desc": "Controlled-T phase gate"
      },
      {
        "gate": "SWAP",
        "module": "SWGate3QubitVector8bit",
        "pipeline_cycles": 1,
        "desc": "Swap two qubits"
      },
      {
        "gate": "PERM",
        "module": "CompatiblePerm (and _1, _2 variants)",
        "pipeline_cycles": 1,
        "desc": "Permutation layer to align target qubit to default position"
      }
    ]
  },
  "encoding": {
    "format": "QSV - Quantum State Vector",
    "num_qubits": 3,
    "num_basis_states": 8,
    "basis_states": "QSV_0..QSV_7 = amplitudes of |000>..|111>; each is two 8-bit signals (_0 real, _1 imag)",
    "fixed_point": "8-bit fixed point (this circuit uses 8-bit datapath). Confirm exact Q-format with library owner."
  },
  "verilog_requirements": {
