{
  "version": "1.0",
  "circuit_name": "QFTcircuit_8bit_NC",
  "description": "3-qubit Quantum Fourier Transform circuit (8-bit datapath): Hadamard and controlled-phase (CS, CT) gates in the QFT pattern, followed by a SWAP to reverse qubit order. Implemented in maximum-parallelism form with permutation layers.",
  "qubits": [
    {
      "id": 0,
      "name": "q0"
    },
    {
      "id": 1,
      "name": "q1"
    },
    {
      "id": 2,
      "name": "q2"
    }
  ],
  "operations": [
    {
      "step": 0,
      "gate": "H",
      "targets": [
        0
      ],
      "module": "HGate3QubitVector8bit",
      "instance_name": "m",
      "perm_required": false,
      "pipeline_cycles": 5,
      "reason": "Hadamard on qubit 0 (default position) - no permutation"
    },
    {
      "step": 1,
      "gate": "CS",
      "controls": [
        0
      ],
      "targets": [
        1
      ],
      "module": "CSGate3QubitVector8bit",
      "instance_name": "m_1",
      "perm_required": false,
      "pipeline_cycles": 1,
      "reason": "Controlled-S on default (q1,q0) two-qubit position - no permutation"
    },
    {
      "step": 2,
      "gate": "CT",
      "controls": [
        0
      ],
      "targets": [
        2
      ],
      "module": "CTGate3QubitVector8bit",
      "instance_name": "m_3",
      "perm_required": true,
      "pipeline_cycles": 1,
      "reason": "Controlled-T targets qubit 2 - CompatiblePerm before and after to map to default position"
    },
    {
      "step": 3,
      "gate": "H",
      "targets": [
        1
      ],
      "module": "HGate3QubitVector8bit",
      "instance_name": "m_5",
      "perm_required": true,
      "pipeline_cycles": 5,
      "reason": "Hadamard on qubit 1 - permutation used (shared bracket with following CS)"
    },
    {
      "step": 4,
      "gate": "CS",
      "controls": [
        1
      ],
      "targets": [
        2
      ],
      "module": "CSGate3QubitVector8bit",
      "instance_name": "m_6",
      "perm_required": true,
      "pipeline_cycles": 1,
      "reason": "Controlled-S targeting qubit 2 - CompatiblePerm to map to default position"
    },
    {
      "step": 5,
      "gate": "H",
      "targets": [
        2
      ],
      "module": "HGate3QubitVector8bit",
      "instance_name": "m_8",
      "perm_required": true,
      "pipeline_cycles": 5,
      "reason": "Hadamard on qubit 2 - CompatiblePerm before and after"
    },
    {
      "step": 6,
      "gate": "SWAP",
      "targets": [
        0,
        2
      ],
      "module": "SWGate3QubitVector8bit",
      "instance_name": "m_10",
      "perm_required": true,
      "pipeline_cycles": 1,
      "reason": "SWAP reversing qubit order (q0<->q2) - CompatiblePerm layers to align"
    }
  ],
  "hardware_pipeline": [
    {
      "stage": 0,
      "module": "HGate3QubitVector8bit",
      "instance": "m",
      "cycles": 5
    },
