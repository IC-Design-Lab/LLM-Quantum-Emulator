  "usage_notes": {
    "primitive_vs_wrapper": "Each gate has a PRIMITIVE module (listed as 'primitive_module') and a WRAPPER module (listed as 'wrapper_module'). Top-level circuits MUST instantiate the wrapper_module by its exact stated name (e.g. HadamardGate -> HGate2QubitVector16bit, SwapGate -> SWGate2QubitVector16bit) and MUST NOT instantiate the primitive directly. The wrapper applies the primitive across the full state vector and exposes the 'wrapper_ports' shown. Do not derive wrapper names from a pattern - use the exact wrapper_module value given for each gate.",
    "file_naming_warning": "The .sv FILENAMES in the source folder do NOT match their contents (files were shuffled). Always identify a gate by its 'module <Name>' line, not by filename.",
    "unconfirmed": [
      "H latency (3 vs 5)",
      "T gate latency",
      "Q1.15 vs Q2.14 fixed-point format",
      "SX/SXdg wrapper latency",
      "Y/Z/T/SX wrapper module names (no ground-truth circuit exercises them; confirm with library owner)"
    ],
    "wrapper_naming_note": "Wrapper names are NOT a uniform suffix of the primitive name (HadamardGate->HGate..., SwapGate->SWGate..., ControlledNotGate->CNGate...). Always use the explicit wrapper_module field."
  }
